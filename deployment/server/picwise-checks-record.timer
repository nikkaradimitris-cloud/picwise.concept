# The night of the checks' eight bots, recorded at 03:07 UTC, after their day ends (03:05) and
# well before the preparation reads its decisions (04:17); a clone still finishing is waited for
# 20 minutes at most. Installed by deployment/server/deploy.sh; enabled only while
# data/checks_clones.json names every bot among its `bots`.
[Unit]
Description=PicWise: the night of the checks' bots, recorded

[Timer]
OnCalendar=*-*-* 03:07:00 UTC
Persistent=false

[Install]
WantedBy=timers.target
