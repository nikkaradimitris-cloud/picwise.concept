# Asks the shops whose rows carry no category for their own catalogue, each product's
# type and stock (deployment/bot/shop_catalogue_bot.py; owner, 2026-10-26: «Θα κάνεις το
# 2 και το 3»), and keeps what they say in /srv/picwise/shared/shops, never in Supabase.
# Run every night by picwise-shops.timer, before picwise-prepare.service, which reads it.
# Installed by deployment/server/deploy.sh.
[Unit]
Description=PicWise: ask the shops for their catalogues (type and stock)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=picwise
Group=picwise
WorkingDirectory=/srv/picwise/current
Environment=PYTHONPATH=/srv/picwise/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 deployment/bot/shop_catalogue_bot.py
TimeoutStartSec=60min
Nice=10
MemoryHigh=3G
MemoryMax=4G
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/picwise/shared
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
