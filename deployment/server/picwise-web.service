# PicWise's site on its own server: gunicorn running deployment/server/wsgi_server.py.
# It listens on 127.0.0.1 only: nothing reaches it from the internet, so Google cannot
# see it, until a web server in front is put there with the domain, on the owner's word.
# Installed by deployment/server/deploy.sh.
[Unit]
Description=PicWise site (gunicorn, local port 8016)
After=network-online.target
Wants=network-online.target

[Service]
User=picwise
Group=picwise
# The site answers from the prepared catalogue only. It is not given the feed link
# (only picwise-prepare.service is), so it never downloads the feed itself, as a Vercel
# function would with no prepared file: with a feed of hundreds of thousands of products,
# each worker loading it would exhaust the memory. Without a fresh prepared file (30 h)
# it shows no products, as with no feed.
Environment=PICWISE_PREPARED_CATALOGUE_FILE=/srv/picwise/shared/prepared/catalogue.json.gz
Environment=PICWISE_STATIC_DIR=/srv/picwise/shared/public
# The current offers of PicWise's shops, fetched every night by picwise-offers.service:
# a product an offer covers comes right after the Recommended (owner, 2026-11-01).
Environment=PICWISE_OFFERS_FILE=/srv/picwise/shared/offers/offers.json
# The photos the nightly check found gone (picwise-photos.service): their products are not
# shown (owner, 2026-11-01: «Όταν το προϊόν δεν φέρνει φωτογραφία δεν πρέπει να εμφανίζεται»).
# Only the site reads it; the preparation keeps every product, so the check can ask again.
Environment=PICWISE_GONE_PHOTOS_FILE=/srv/picwise/shared/photos/gone.json
# The folder the site shares with picwise-assist, the AI layer's service: for a complex
# search the site writes a job there and reads the answer; it never calls the API and is
# never given the key (owner, 2026-11-06; docs/PICWISE_AI_LAYER_SPEC.md, 4.5). Without
# its jobs/ folder, which the deployment makes only when the service has its key, the
# site writes nothing there and its pages are as before.
Environment=PICWISE_ASSIST_DIR=/srv/picwise/assist
Environment=PYTHONDONTWRITEBYTECODE=1
# The release in use is resolved once, at start: a worker gunicorn starts again later
# loads the same code, even after a deployment has pointed `current` to a newer one.
ExecStart=/bin/sh -c 'release=$$(readlink -f /srv/picwise/current) && exec /srv/picwise/venv/bin/gunicorn \
    --chdir "$$release" --pythonpath "$$release/deployment/server" --bind 127.0.0.1:8016 \
    --workers 4 --timeout 300 --graceful-timeout 30 --access-logfile - --no-control-socket wsgi_server:app'
Restart=always
RestartSec=2
# A ceiling, so that the site can never take the memory sshd and the rest need.
MemoryHigh=11G
MemoryMax=12G
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/picwise/shared -/srv/picwise/assist
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
