# Every day at 05:30 UTC, after the preparation (04:17) and the photos' check (04:40): the
# checks then ask all day, until 03:05 UTC the next day (owner, 2026-11-22: «Ναι, όλη μέρα»),
# before the updates' reboot window (03:30) and the next preparation, which reads what they
# decided. Not caught up after a stop: a deployment starts the round again itself, and the
# round goes on from the answers it kept. Installed by deployment/server/deploy.sh.
[Unit]
Description=PicWise: the checks of the products, all day

[Timer]
OnCalendar=*-*-* 05:30:00 UTC
Persistent=false

[Install]
WantedBy=timers.target
