# Prepares the catalogue from the feed, as each Vercel deployment's build does
# (`vercel.json` "buildCommand"): run once by each deployment and every night by
# picwise-prepare.timer. The site picks the new file up by itself.
# Installed by deployment/server/deploy.sh.
[Unit]
Description=PicWise: prepare the catalogue from the feed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=picwise
Group=picwise
WorkingDirectory=/srv/picwise/current
EnvironmentFile=-/etc/picwise/picwise.env
Environment=AWIN_FEED_CACHE_DIR=/srv/picwise/shared/cache
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 tools/prepare_catalogue.py --keep-going \
    --static-dir /srv/picwise/shared/public --out /srv/picwise/shared/prepared/catalogue.json.gz
TimeoutStartSec=60min
Nice=10
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/picwise/shared
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
