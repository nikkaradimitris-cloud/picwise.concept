# Prepares the catalogue from the feed, as each Vercel deployment's build does
# (`vercel.json` "buildCommand"): run once by each deployment and every night by
# picwise-prepare.timer. The site picks the new file up by itself.
# Installed by deployment/server/deploy.sh.
[Unit]
Description=PicWise: prepare the catalogue from the feed
# A round of the shops' catalogues, or of the checks, still running is waited for: both are read here.
After=network-online.target picwise-shops.service picwise-checks.service
Wants=network-online.target

[Service]
Type=oneshot
User=picwise
Group=picwise
WorkingDirectory=/srv/picwise/current
# The feed link, written by the deployment from GitHub's secrets; never in the repository.
EnvironmentFile=-/etc/picwise/picwise.env
Environment=AWIN_FEED_CACHE_DIR=/srv/picwise/shared/cache
# The code's 300 MB cap is a Vercel-sized one; the server takes a feed of every shop.
Environment=AWIN_FEED_MAX_BYTES=2147483648
# What the shops' own catalogues say, written by picwise-shops.service
# (`picwise_providers.shop_catalogue`).
Environment=PICWISE_SHOP_CATALOGUES=/srv/picwise/shared/shops/catalogues.json.gz
# What the checks decided (docs/PICWISE_CHECKS_RULES.md), applied behind data/checks_switch.json;
# the rows the checks' bot asks next are written beside it.
Environment=PICWISE_CHECKS_DECISIONS=/srv/picwise/shared/checks/decisions.json.gz
# The cap's two limits (owner, 2026-11-19: changeable, to open as the server grows):
# no category over this share, and at most this many products a category.
Environment=PICWISE_CAP_SHARE=0.15
Environment=PICWISE_CAP_CATEGORY_MAX=12000
# The AI's line of Google's taxonomy for each product (owner, 2026-11-20; written by
# .github/workflows/ai-shelves-scan.yml, picwise-assist's, which this user's group reads):
# the second link's rows read it as their Google line, and every product's kind is read
# against it (`picwise_providers.ai_shelves`). Without the file, nothing changes.
Environment=PICWISE_AI_SHELVES_FILE=/srv/picwise/assist/shelves/answers.jsonl.gz
# The products the AI is asked the category of next (the checks' rules 5.5), for
# picwise-shelves.service; the folder is the site's to write and the AI layer's to read.
Environment=PICWISE_SHELF_JOBS=/srv/picwise/assist/shelves/jobs
# The answers to the question "is it the kind itself" (docs/PICWISE_KIND_ITSELF_RULES.md;
# written by picwise-itself.service, picwise-assist's, which this user's group reads), read
# only while data/kind_itself_switch.json is true; and the questions the AI is asked next,
# written for that service.
Environment=PICWISE_KIND_ITSELF_FILE=/srv/picwise/assist/itself/answers.jsonl.gz
Environment=PICWISE_ITSELF_JOBS=/srv/picwise/assist/itself/jobs
Environment=PYTHONDONTWRITEBYTECODE=1
# GNU time adds one line with the run's peak memory and length, for sizing the server.
ExecStart=/usr/bin/time -f "prepare_catalogue: peak memory %%M KB, %%e s" /usr/bin/python3 \
    tools/prepare_catalogue.py --keep-going \
    --static-dir /srv/picwise/shared/public --out /srv/picwise/shared/prepared/catalogue.json.gz \
    --memory /srv/picwise/shared/prepared/catalogue_memory.sqlite
TimeoutStartSec=60min
Nice=10
# A ceiling, so that reading a large feed can never take the memory the site needs.
# Raised on 2026-11-19 for the second Awin link (the trial's peak 15.4 GB; one GB more the
# same evening, the owner: «θα προσθέσεις το ένα gigabyte»), the site's
# workers lowered to 3 so that both fit the server's 24 GB; past it the preparation alone
# stops, and the site keeps answering from the night before's catalogue.
MemoryHigh=17G
MemoryMax=18G
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/picwise/shared
ReadWritePaths=-/srv/picwise/assist/shelves/jobs
ReadWritePaths=-/srv/picwise/assist/itself/jobs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
