# The category of each product not asked yet, asked of Claude Haiku 5.5 each morning (the
# checks' rules 5.5 and 7.6; owner, 2026-11-21: «Το AI ρωτιέται μία φορά για την κατηγορία
# κάθε προϊόντος. Όποιο προϊόν δεν μπαίνει σε κατηγορία βγαίνει»). Installed by
# deployment/server/deploy.sh, run only when GitHub holds the key.
#
# Under the AI layer's own user, with its key (/etc/picwise/assist.env, which only systemd
# reads), never the site's: it reads the products the night's preparation names in
# /srv/picwise/assist/shelves/jobs (checks_applied.shelf_items) and writes the answers the
# preparation reads in /srv/picwise/assist/shelves. At most $10 a night (a brake for a loop
# gone wrong; a night's need is cents) and 2 hours (deployment/server/shelves_service.py).
[Unit]
Description=PicWise: the AI's category of the products not asked yet
After=network-online.target picwise-prepare.service
Wants=network-online.target

[Service]
Type=oneshot
User=picwise-assist
Group=picwise-assist
EnvironmentFile=-/etc/picwise/assist.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/sh -c 'release=$$(readlink -f /srv/picwise/current) && exec /srv/picwise/venv-ai/bin/python \
    "$$release/deployment/server/shelves_service.py" --dir /srv/picwise/assist/shelves'
TimeoutStartSec=150min
Nice=10
MemoryHigh=768M
MemoryMax=1G
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/picwise/assist/shelves
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
