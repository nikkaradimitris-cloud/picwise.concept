# The sets of listings the AI is asked about (deployment/server/family_jobs.py; owner,
# 2026-11-19: one card per product): written after each preparation of the catalogue and
# at each deployment, as the site's user, into the folder it shares with picwise-families.
[Unit]
Description=PicWise: write the sets of listings the AI is asked about
After=picwise-prepare.service

[Service]
Type=oneshot
User=picwise
Group=picwise
WorkingDirectory=/srv/picwise/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 deployment/server/family_jobs.py \
    --catalogue /srv/picwise/shared/prepared/catalogue.json.gz \
    --jobs /srv/picwise/assist/families/jobs \
    --answers /srv/picwise/assist/families/answers/sets.json
TimeoutStartSec=30min
Nice=10
MemoryHigh=6G
MemoryMax=8G
# If the server runs short of memory, this goes before the site.
OOMScoreAdjust=500
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=-/srv/picwise/assist/families/jobs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
