# Checks which products' photos are gone, for the site to leave them out
# (deployment/server/check_photos.py; owner, 2026-11-01: «Όταν το προϊόν δεν φέρνει
# φωτογραφία δεν πρέπει να εμφανίζεται... Στις περισσότερες περιπτώσεις είναι not found»).
# It reads the photos of the prepared catalogue, asks each address at most an hour a night,
# keeps the answers in /srv/picwise/shared/photos/photos.sqlite3, and writes the gone ones to
# /srv/picwise/shared/photos/gone.json, which picwise-web.service reads. Run every night by
# picwise-photos.timer, after the preparation, and once by each deployment, in the background.
# Installed by deployment/server/deploy.sh.
[Unit]
Description=PicWise: check which products' photos are gone
# A preparation still running is waited for: its catalogue's photos are checked here.
After=network-online.target picwise-prepare.service
Wants=network-online.target

[Service]
Type=oneshot
User=picwise
Group=picwise
WorkingDirectory=/srv/picwise/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 deployment/server/check_photos.py \
    --catalogue /srv/picwise/shared/prepared/catalogue.json.gz \
    --db /srv/picwise/shared/photos/photos.sqlite3 --out /srv/picwise/shared/photos/gone.json \
    --budget-minutes 60
TimeoutStartSec=90min
Nice=10
# The catalogue is read whole once, then let go before any photo is asked.
MemoryHigh=3G
MemoryMax=4G
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/picwise/shared
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
