# The question "is it the kind itself", asked each morning for the products the night's
# preparation named (docs/PICWISE_KIND_ITSELF_RULES.md, 8.2; the owner's plan of 21/11,
# step 8: «είναι το ίδιο το προϊόν ή αξεσουάρ, ανταλλακτικό ή αναλώσιμο;»): the first reading
# by Claude Haiku 5.5, the second by Claude Sonnet 5.5. Installed by
# deployment/server/deploy.sh, run only when GitHub holds the key.
#
# Under the AI layer's own user, with its key (/etc/picwise/assist.env, which only systemd
# reads), never the site's: it reads the questions the night's preparation names in
# /srv/picwise/assist/itself/jobs (picwise_providers.kind_itself.job_items) and writes the
# answers the preparation reads in /srv/picwise/assist/itself. The preparation names nothing
# while data/kind_itself_switch.json is false, and then nothing is asked. At most $5 a night
# (a brake for a loop gone wrong; a night's need is cents) and 2 hours
# (deployment/server/itself_service.py).
[Unit]
Description=PicWise: the AI's answer to "is it the kind itself" for the products named
After=network-online.target picwise-prepare.service picwise-shelves.service
Wants=network-online.target

[Service]
Type=oneshot
User=picwise-assist
Group=picwise-assist
EnvironmentFile=-/etc/picwise/assist.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/sh -c 'release=$$(readlink -f /srv/picwise/current) && exec /srv/picwise/venv-ai/bin/python \
    "$$release/deployment/server/itself_service.py" --dir /srv/picwise/assist/itself'
TimeoutStartSec=150min
Nice=10
MemoryHigh=768M
MemoryMax=1G
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/picwise/assist/itself
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
