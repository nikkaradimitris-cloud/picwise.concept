# The quality meter (docs/PICWISE_KIND_ITSELF_RULES.md, section 9; the owner's plan of 21/11,
# step 9: «μετρητής ποιότητας», the same 40 searches each day): each morning the first cards of
# the 40 fixed searches, and of a seventh of the kinds, are read from the site's own pages on
# the server itself and judged by Claude Opus 5.5, which has no part in what it measures. A
# card is judged once. Installed by deployment/server/deploy.sh, run only when GitHub holds
# the key.
#
# Under the AI layer's own user, with its key (/etc/picwise/assist.env, which only systemd
# reads), never the site's. It asks the site only for pages, as a visitor's browser does with
# no script; it writes its verdicts and the day's note in /srv/picwise/assist/meter, and
# nothing else. Its verdicts change nothing shown. At most $2 a day
# (deployment/server/meter_service.py).
[Unit]
Description=PicWise: the first cards of fixed searches judged, the day's quality
After=network-online.target picwise-prepare.service picwise-itself.service picwise-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=picwise-assist
Group=picwise-assist
EnvironmentFile=-/etc/picwise/assist.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/sh -c 'release=$$(readlink -f /srv/picwise/current) && exec /srv/picwise/venv-ai/bin/python \
    "$$release/deployment/server/meter_service.py" --dir /srv/picwise/assist/meter'
TimeoutStartSec=60min
Nice=10
MemoryHigh=768M
MemoryMax=1G
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/picwise/assist/meter
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
