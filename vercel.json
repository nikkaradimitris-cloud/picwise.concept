{
  "version": 2,
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 tools/prepare_catalogue.py --keep-going --static-dir public --sample-shop-pages 20",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/cron/renew-prepared-feed",
      "schedule": "17 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/demo",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
